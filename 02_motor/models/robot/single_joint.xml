<mujoco model="single_joint_pd">
    <option timestep="0.002" gravity="0 0 0"/>

    <worldbody>
        <!-- 固定底座 -->
        <geom name="base"
              type="box"
              pos="0 0 0"
              size="0.08 0.08 0.08"
              rgba="0.3 0.3 0.3 1"
              contype="0"
              conaffinity="0"/>

        <!-- 只有一个旋转自由度的连杆 -->
        <body name="arm" pos="0 0 0">
            <joint name="joint1"
                   type="hinge"
                   axis="0 0 1"
                   damping="0.1"/>

            <geom name="link"
                  type="box"
                  pos="0.3 0 0"
                  size="0.3 0.025 0.025"
                  mass="1"
                  rgba="0.2 0.6 0.9 1"/>
        </body>
    </worldbody>

    <actuator>
        <motor name="motor1"
               joint="joint1"
               gear="1"
               ctrllimited="true"
               ctrlrange="-20 20"/>
    </actuator>
</mujoco>